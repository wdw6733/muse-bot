# 3 号机器人 token（@BotFather 创建）。只写在这里，不要发给任何人、不要提交到仓库、不要提交到 Muse。
BOT_TOKEN=
# 主人 chat id（与 2 号机器人同一个，已预填）
OWNER_CHAT_ID=9166303246
# OpenBox SOCKS5（TG 出口）。无账号密码时用下面这行；入口设了账号密码时改成 socks5h://用户名:密码@192.168.124.250:57080
SOCKS_PROXY=socks5h://192.168.124.250:57080
# ESXi（留空则 /esxi 命令不可用）。ESXI_HOST 填 ESXi 管理 IP。
ESXI_HOST=
ESXI_USER=root
ESXI_PASSWORD=
# 也可以用密钥代替密码（二选一）：把私钥挂载到 /data 并填路径，例如 /data/id_ed25519
# ESXI_KEY_FILE=/data/id_ed25519
# 磁盘路径（逗号分隔）：留空默认 /mnt/PT,/mnt/Strongge；填了就按填的来。
HOST_DATA_PATHS=
# 重启 NAS 用的 VM（可选）：填 NAS 这个 VM 在 ESXi 里的名字或 ID，留空则“重启 NAS”按钮不可用。
# NAS_VM_NAME=
# NAS_VM_ID=
# “给 Muse 下指令”按钮跳到的 2 号机器人用户名（默认 MuseAI6_Bot，一般不用改）
# MUSE_BOT_USERNAME=MuseAI6_Bot

# ---- 主动告警（v2.2）：默认开启；ALERT_ENABLED=0 关闭。阈值按需改。
ALERT_ENABLED=1
ALERT_INTERVAL_SEC=300
ALERT_DISK_PCT=90
ALERT_LOAD_MULT=2.0
ALERT_MEM_PCT=92
ALERT_COOLDOWN_SEC=3600
# ---- 自我更新（v2.2）：仓库根目录放 bot.py；公开仓库不用填 TOKEN，私有仓库填只读 TOKEN。
UPDATE_REPO=
UPDATE_BRANCH=main
UPDATE_TOKEN=
# 自我更新重启自己用的容器名，和 compose 里的 container_name 一致。
SELF_CONTAINER_NAME=tg-bot3
# ---- 容器镜像更新检测（v2.3）：默认开启，每 6 小时自动检查全部容器，有新镜像就通知。
# IMAGE_CHECK_ENABLED=0 关闭自动检查（手动按钮/命令仍可用）。间隔单位是秒。
IMAGE_CHECK_ENABLED=1
IMAGE_CHECK_INTERVAL_SEC=21600
# ---- TrueNAS 系统服务（v2.5.0）：SSH 优先，API 备用；都不填则“系统服务”功能提示未配置。
# NAS 地址（默认就是这个，一般不用改）
TRUENAS_HOST=192.168.124.251
# SSH：先在 TrueNAS 网页 → System Settings → Services → SSH → 开启（默认 22 端口）。
# 密钥和密码二选一，推荐密钥：把私钥放 ./truenas_key（不要提交），compose 里挂载到 /keys/truenas_key。
TRUENAS_SSH_PORT=22
TRUENAS_SSH_USER=root
# TRUENAS_SSH_KEY_FILE=/keys/truenas_key
# TRUENAS_SSH_PASSWORD=
# API 备用：TrueNAS 网页 → Credentials → API Keys → 新建。
# 只填 API_KEY 就走 REST v2.0；TrueNAS 26 已移除 REST，26 及以后必须用 SSH。
# TRUENAS_API_URL=https://192.168.124.251/api/v2.0
# TRUENAS_API_KEY=
